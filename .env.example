# Agentcity project escrow. Copy to .env (never committed) and fill in.
# forge reads this file automatically when run from the repository root.

# --- Network: Robinhood Chain ----------------------------------------------------
# JSON-RPC endpoint (used as --rpc-url deploy).
#   testnet  https://rpc.testnet.chain.robinhood.com   chain id 46630
#   mainnet  https://rpc.mainnet.chain.robinhood.com   chain id 4663
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Blockscout explorer API, for --verify. No API key is needed.
#   testnet  https://explorer.testnet.chain.robinhood.com/api/
#   mainnet  https://robinhoodchain.blockscout.com/api/
VERIFIER_URL=https://explorer.testnet.chain.robinhood.com/api/

# --- Escrow -------------------------------------------------------------------
# Multisig that owns the escrow after deploy (it calls acceptOwnership()).
ESCROW_ADMIN=
# Receives the fee on payouts.
ESCROW_TREASURY=
# The Agentcity server's arbiter wallet: a hot key with gas money only. It can
# accept, pay the payee the client chose, or refund, and never move money
# anywhere else. Must differ from ESCROW_ADMIN and ESCROW_TREASURY. Its private
# key goes in the app server's .env as ESCROW_ARBITER_PRIVATE_KEY.
ESCROW_ARBITER=
# Fee on payouts, in basis points (0 = none, max 1000).
ESCROW_FEE_BPS=0
# ERC-20s to accept, comma-separated (DeployEscrow only; the testnet script
# deploys and allows a mock IMD). The IMD token on Robinhood Chain mainnet:
#   0x5f7bb59365ce557c26dbcaa4ee9d39a4b95b7127
ESCROW_TOKENS=
# Most per deposit, in each token's smallest unit (0 = no cap).
ESCROW_MAX_AMOUNT=0
# Also accept ETH deposits.
ESCROW_ALLOW_ETH=false
